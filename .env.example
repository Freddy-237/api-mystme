# ============================================
# MystMe Backend — Environment Variables
# ============================================
# Copy this file to .env and fill in the values.
#
# STATUS LEGEND:
#   [REQUIRED]   – must be set for production
#   [OPTIONAL]   – recommended but not required
#   [DEV-ONLY]   – for development/testing only

# --- Server ---
PORT=5000
NODE_ENV=development
# [REQUIRED] production: strong random secret (min 32 chars)
JWT_SECRET=your-jwt-secret-here

# --- Database ---
# [REQUIRED] Railway/cloud: DATABASE_URL takes precedence over individual DB vars
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mystme
# [REQUIRED] Local development: if DATABASE_URL is not set
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=mystme
# [OPTIONAL] production: set to true for SSL connections
DB_SSL=false

# --- CORS ---
# [REQUIRED] production: comma-separated list of allowed origins your PWA is hosted at
# Examples: https://mystme.app,https://www.mystme.app
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Cloudinary (required for media uploads) ---
# [REQUIRED] production: image/video/audio/file uploads will fail without these
# Get keys from: https://cloudinary.com/console/settings/api-keys
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Database backups ---
# [RECOMMENDED] production: random string (32+ chars) that encrypts the daily
# backups stored on Cloudinary. Without it, NO backup is made. Keep a copy in a
# password manager: it is the only way to read a backup if the server is lost.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BACKUP_ENCRYPTION_KEY=

# --- Firebase (required for push notifications) ---
# [OPTIONAL] JSON string of service-account credentials from Firebase Console
# To generate: https://console.firebase.google.com → Project Settings → Service Accounts
FIREBASE_SERVICE_ACCOUNT_JSON=

# --- IAP Receipt Validation (required for in-app purchases) ---
# [OPTIONAL] Apple: shared secret from App Store Connect
# To generate: https://appstoreconnect.apple.com → Users and Access → Tokens
APPLE_SHARED_SECRET=
# [OPTIONAL] Google: JSON string of Google Play service-account credentials
GOOGLE_SERVICE_ACCOUNT=
GOOGLE_PACKAGE_NAME=com.mystme.app

# --- Email OTP (Phase 2: Account recovery & cross-device auth) ---
# [REQUIRED] production: at least one email provider must be configured
# The backend tries Brevo first, then SMTP as fallback.

# Option 1: Brevo transactional email (RECOMMENDED for production)
#   Get API key: https://app.brevo.com/settings/keys/api
# [OPTIONAL] When set, overrides SMTP_*
BREVO_API_KEY=
# [OPTIONAL] Sender email for Brevo (falls back to MAIL_FROM if not set)
BREVO_SENDER_EMAIL=
# [OPTIONAL] Sender name for Brevo emails
BREVO_SENDER_NAME=MystMe

# Option 2: SMTP (traditional email server)
#   Required fields for SMTP: SMTP_HOST, SMTP_PORT, SMTP_USER, SMTP_PASS, MAIL_FROM
#   Optional: SMTP_SECURE (set to true for port 465, false for 587 with STARTTLS)
# [OPTIONAL] SMTP server hostname (e.g. smtp.gmail.com)
SMTP_HOST=
SMTP_PORT=587
# [OPTIONAL] Set to true for SSL/TLS on port 465, false for STARTTLS on 587
SMTP_SECURE=false
# [OPTIONAL] SMTP username/password
SMTP_USER=
SMTP_PASS=
# [OPTIONAL] Email address and name to send OTP from
MAIL_FROM="MystMe <no-reply@mystme.app>"

# --- Optional ---
AUTH_COOKIE_NAME=mystme_token
AUTH_COOKIE_DOMAIN=
CSRF_COOKIE_NAME=mystme_csrf
CSRF_HEADER_NAME=x-csrf-token
LOG_LEVEL=info

# --- Monitoring (optional) ---
# [OPTIONAL] Sentry DSN for error tracking and uptime monitoring
# To get DSN: https://sentry.io → Create Project → Copy DSN
SENTRY_DSN=
